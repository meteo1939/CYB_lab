<% var bodyClass = 'gate-page'; %>
<%- include('partials/top') %>
<main class="gate">
  <form class="card wide" method="post" action="/haslo/zmiana">
    <p class="eyebrow"><%= reason === 'expired' ? 'Hasło wygasło' : 'Pierwsze logowanie' %></p>
    <h1><%= reason === 'expired' ? 'Ustaw nowe hasło' : 'Zmień hasło nadane przez administratora' %></h1>
    <% if (reason === 'first') { %>
      <p class="muted">Hasło jednorazowe działa tylko przy tym wejściu. Wpisz własne hasło dwa razy. Nie da się zostawić kodu od administratora.</p>
    <% } else { %>
      <p class="muted">Minął termin ważności hasła ustawiony przez administratora. Podaj dotychczasowe hasło i wybierz nowe.</p>
    <% } %>
    <% if (errors && errors.length) { %>
      <ul class="errors"><% errors.forEach(function (item) { %><li><%= item %></li><% }) %></ul>
    <% } %>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (reason !== 'first') { %>
      <label for="current_password">Dotychczasowe hasło</label>
      <div class="password-row">
        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
        <button class="text-btn" type="button" data-reveal="current_password">Pokaż</button>
      </div>
    <% } %>
    <%- include('partials/new-password') %>
    <button class="button" type="submit">Zapisz hasło</button>
  </form>
  <form method="post" action="/wyloguj">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="button ghost" type="submit">Wyloguj</button>
  </form>
</main>
<%- include('partials/bottom') %>
